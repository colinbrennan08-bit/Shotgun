# Public Supabase config. Safe in a public repo on purpose.
#
# The publishable key identifies the project and grants nothing on its own.
# Everything a holder of it can read or write is decided by the row-level
# security policies in supabase/schema.sql. It is readable in the published
# JavaScript no matter where it is stored, so hiding it would be theatre.
#
# The service_role / secret key is the opposite and must never appear here.

EXPO_PUBLIC_SUPABASE_URL=https://zunheplowqlfbeqyrgac.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_jvtqZ0V3WQcJtp7kojBjlw_teFVxMAh
