# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard > Project Settings > Data API
#
# Both values are safe to commit to a public repo and both end up in the
# published JavaScript. The anon key identifies the project; it does not grant
# anything on its own. Everything a holder of it can read or write is decided
# by the row-level security policies in supabase/schema.sql.
#
# The service_role key is the opposite of that. It bypasses every policy.
# It must never appear in this file, in the app, or in the repo.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
